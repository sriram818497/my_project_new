generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(120)
  role         UserRole @default(admin)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Job {
  id                  String    @id @db.VarChar(80)
  jobCode             String?   @unique @map("job_code") @db.VarChar(32)
  title               String    @db.VarChar(180)
  department          String    @db.VarChar(120)
  location            String    @db.VarChar(120)
  type                String    @db.VarChar(80)
  education           String?   @db.VarChar(120)
  experience          String?   @db.VarChar(120)
  skills              Json?
  salaryMin           Int?      @map("salary_min")
  salaryMax           Int?      @map("salary_max")
  postedDate          DateTime? @map("posted_date") @db.Date
  applicationDeadline DateTime? @map("application_deadline") @db.Date
  walkIn              Boolean   @default(false) @map("walk_in")
  roleOverview        String    @map("role_overview") @db.Text
  aboutRole           String    @map("about_role") @db.Text
  responsibilities    Json?
  qualifications      Json?
  desiredSkills       Json?     @map("desired_skills")
  status              JobStatus @default(draft)
  isFeatured          Boolean   @default(false) @map("is_featured")
  publishedAt         DateTime? @map("published_at")
  createdAt           DateTime  @map("created_at")
  updatedAt           DateTime  @map("updated_at")

  applicants Applicant[]

  @@map("jobs")
}

model Applicant {
  id               String           @id @db.VarChar(80)
  jobId            String           @map("job_id") @db.VarChar(80)
  name             String           @db.VarChar(120)
  email            String           @db.VarChar(255)
  phone            String           @db.VarChar(30)
  gender           ApplicantGender?
  education        String           @db.VarChar(120)
  location         String           @db.VarChar(120)
  experience       String           @db.VarChar(120)
  skills           Json
  resumeUrl        String           @map("resume_url") @db.VarChar(500)
  resumeName       String           @map("resume_name") @db.VarChar(255)
  stage            ApplicantStage   @default(Applied)
  rating           Int              @default(3)
  stageRatings     Json?            @map("stage_ratings")
  roundEvaluations Json?            @map("round_evaluations")
  notes            Json
  rejectionReason  String?          @map("rejection_reason") @db.Text
  taskAssignment   Json?            @map("task_assignment")
  taskSubmissionUrl String?         @map("task_submission_url") @db.VarChar(500)
  taskSubmissionName String?        @map("task_submission_name") @db.VarChar(255)
  stageHistory     Json             @map("stage_history")
  appliedAt        DateTime         @map("applied_at")
  updatedAt        DateTime         @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "idx_applicants_job_id")
  @@map("applicants")
}

model RightsRequest {
  id        String              @id @db.VarChar(40)
  payload   Json
  status    RightsRequestStatus @default(pending)
  createdAt DateTime            @map("created_at")

  @@map("rights_requests")
}

model EventRegistration {
  id                 String           @id @db.VarChar(80)
  eventId            String           @map("event_id") @db.VarChar(80)
  eventTitle         String           @map("event_title") @db.VarChar(255)
  fullName           String           @map("full_name") @db.VarChar(120)
  email              String           @db.VarChar(255)
  currentRole        String           @map("current_role") @db.VarChar(120)
  organization       String           @db.VarChar(180)
  originCity         String           @map("origin_city") @db.VarChar(120)
  contact            String?          @db.VarChar(30)
  consent            Boolean
  attendanceStatus   AttendanceStatus @default(registered) @map("attendance_status")
  registeredAt       DateTime         @map("registered_at")
  attendanceUpdatedAt DateTime?       @map("attendance_updated_at")

  @@index([eventId], map: "idx_event_registrations_event_id")
  @@index([email], map: "idx_event_registrations_email")
  @@map("event_registrations")
}

model CommunicationPreference {
  id               String                        @id @db.VarChar(40)
  fullName         String                        @map("full_name") @db.VarChar(120)
  email            String                        @unique @db.VarChar(255)
  preferences      Json
  status           CommunicationPreferenceStatus
  source           CommunicationPreferenceSource
  consentCapturedAt DateTime                     @map("consent_captured_at")
  lastUpdated      DateTime                      @map("last_updated")
  lastUpdatedBy    String                        @map("last_updated_by") @db.VarChar(120)

  @@map("communication_preferences")
}

model CookieConsent {
  id            String             @id @db.VarChar(40)
  ipAddress     String             @map("ip_address") @db.VarChar(64)
  stateName     String?            @map("state_name") @db.VarChar(120)
  countryName   String?            @map("country_name") @db.VarChar(120)
  status        ConsentStatus
  essential     Boolean
  analytics     Boolean
  personalization Boolean
  marketing     Boolean
  consentDate   DateTime           @map("consent_date")
  lastUpdated   DateTime           @map("last_updated")
  source        ConsentSource
  cookieSnapshot Json?             @map("cookie_snapshot")

  @@index([ipAddress], map: "idx_cookie_consents_ip")
  @@map("cookie_consents")
}

model SiteContentState {
  key       String   @id @db.VarChar(120)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_content_state")
}

enum UserRole {
  admin
  editor
  viewer
}

enum JobStatus {
  draft
  published
  archived
}

enum ApplicantStage {
  Applied
  Screening
  TaskAssigned @map("Task Assigned")
  TaskSubmitted @map("Task Submitted")
  Interview
  Selected
  Rejected
}

enum ApplicantGender {
  Male
  Female
  NonBinary @map("Non-Binary")
  PreferNotToSay @map("Prefer not to say")
}

enum RightsRequestStatus {
  pending
  in_progress
  completed
}

enum AttendanceStatus {
  registered
  attended
  missed
}

enum CommunicationPreferenceStatus {
  subscribed
  unsubscribed
}

enum CommunicationPreferenceSource {
  preference_center
  admin_console
  unsubscribe_link
  imported
}

enum ConsentStatus {
  accepted_all
  rejected_all
  custom
}

enum ConsentSource {
  banner_accept
  banner_decline
  preference_center
}
